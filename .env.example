# Carbon Bridge — local environment
#
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is gitignored, never commit it.
#
# In Render: add both vars under your service → Environment.
# Vite inlines VITE_* vars at *build* time, so changes require a redeploy.
#
# IMPORTANT: This is a Vite project. Env vars MUST be prefixed VITE_ to
# be exposed to the browser. The legacy REACT_APP_ prefix (Create React App)
# does NOT work with Vite.

# Public anon key — safe to expose to the browser. Find it at:
# Supabase dashboard → Project Settings → API → "Project URL" and "anon public"
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Razorpay public Key ID — safe to expose to the browser. Find it at:
# Razorpay Dashboard → Settings → API Keys → "Key Id"
# Use rzp_test_XXX for test mode, rzp_live_XXX for production.
# WARNING: this client-only flow is fine for test mode but INSECURE for live
# payments. For production, create orders + verify signatures on a backend
# using your secret key. Never expose the secret key to the browser.
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
